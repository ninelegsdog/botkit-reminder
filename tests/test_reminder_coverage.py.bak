@pytest.fixture
async def session_factory(tmp_path: Any) -> Any:
    db = tmp_path / "test.db"
    engine = create_async_engine(f"sqlite+aiosqlite:///{db}")
    async with engine.begin() as conn:
        await conn.run_sync(Base.metadata.create_all)
    factory = async_sessionmaker(engine, expire_on_commit=False)
    return factory


@pytest.mark.asyncio
async def test_reminder_repository_all_methods(session_factory: Any) -> None:
    async with session_factory() as session:
        uow = UnitOfWork(session)
        repo = ReminderRepository(uow)

        fire_at = datetime.now(UTC) - timedelta(minutes=1)
        rem = await repo.create(1, ReminderType.once, "Test", fire_at=fire_at)
        assert rem.id is not None
        assert rem.text == "Test"

        got = await repo.get(rem.id)
        assert got.id == rem.id

        user_rems = await repo.get_by_user(1)
        assert len(user_rems) == 1

        due = await repo.get_due(datetime.now(UTC))
        assert len(due) == 1

        await repo.update_status(rem.id, ReminderStatus.done)
        await session.flush()
        updated = await repo.get(rem.id)
        assert updated.status == ReminderStatus.done

        await repo.delete(rem.id)
        deleted = await repo.get(rem.id)
        assert deleted is None


@pytest.mark.asyncio
async def test_subscriber_repository_all_methods(session_factory: Any) -> None:
    async with session_factory() as session:
        uow = UnitOfWork(session)
        repo = SubscriberRepository(uow)

        sub = await repo.create(1, "user", "Name")
        assert sub.id == 1
        assert sub.is_active is True

        got = await repo.get(1)
        assert got.user_id == 1

        user_sub = await repo.get_by_user(1)
        assert user_sub is not None

        await repo.deactivate(1)
        await session.flush()
        updated = await repo.get(1)
        assert updated.is_active is False


@pytest.mark.asyncio
async def test_scheduler_tick_cancelled_reminder(session_factory: Any) -> None:
    sent: list[tuple[int, str]] = []

    async def send_callback(user_id: int, text: str) -> None:
        sent.append((user_id, text))

    scheduler = Scheduler(session_factory, send_callback)
    async with session_factory() as session:
        uow = UnitOfWork(session)
        service = ReminderService(uow)
        fire_at = datetime.now(UTC) - timedelta(minutes=1)
        reminder = await service.create_reminder(1, ReminderType.once, "Test", fire_at=fire_at)
        await service.cancel_reminder(reminder.id)
        await session.commit()

    await scheduler._tick()
    assert len(sent) == 0


@pytest.mark.asyncio
async def test_scheduler_tick_done_reminder(session_factory: Any) -> None:
    sent: list[tuple[int, str]] = []

    async def send_callback(user_id: int, text: str) -> None:
        sent.append((user_id, text))

